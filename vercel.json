{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://YOUR_AWS_BACKEND_URL/api/$1"
    },
    {
      "src": "/",
      "dest": "/static/index.html"
    },
    {
      "src": "/dashboard.html",
      "dest": "/static/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "/static/$1"
    }
  ]
}
