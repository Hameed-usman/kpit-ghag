# Ghag – Environment Variables

# ── Groq ─────────────────────────────────────────────────────────────────
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── App behaviour ─────────────────────────────────────────────────────────
# Set DEMO_MODE=true to serve offline fixture (eval/demo_fixture.json)
# when Groq API is unavailable (e.g. no internet at venue).
DEMO_MODE=false
PUBLIC_MODE=false
RATE_LIMIT_RPM=10
CONFIDENCE_THRESHOLD=0.75
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=30

# ── Database ──────────────────────────────────────────────────────────────
DB_PATH=ghag.db

# ── Dashboard ─────────────────────────────────────────────────────────────
# Token required for POST /api/v1/dashboard/approve
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=change_me_before_demo

# ── TTS voices ────────────────────────────────────────────────────────────
# See: python -m edge_tts --list-voices | grep -E "ur|ps"
TTS_VOICE_UR=ur-PK-AsadNeural
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_PS=ur-PK-AsadNeural
